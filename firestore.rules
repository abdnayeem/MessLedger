rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The app stores its whole state as one document under this collection.
    // We require request.auth != null (satisfied by the anonymous sign-in
    // in firebase-config.js) so that only traffic coming from the app itself
    // can read/write — random requests hitting your API key directly with
    // no auth token get rejected. This is NOT per-member access control
    // (that still lives in your app's PIN system) — it's just a floor that
    // stops drive-by abuse of an open database.
    match /mealAppStorage/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Login/action logs — split out into their own collection so they're
    // never part of the live listener the rest of the app opens on
    // mealAppStorage (see the LOGS_COLLECTION comment in storage.js). Same
    // floor as above: any authenticated (anonymous sign-in counts) client
    // from the app itself can read/write, real access control is still the
    // app's own PIN/role system.
    match /mealAppLogs/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Everything else: locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
